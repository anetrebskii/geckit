{
  "name": "geckit",
  "version": "1.0.0",
  "description": "Correct text, dictate it, and talk to Claude Code, from one small window",
  "keywords": [
    "geckit"
  ],
  "homepage": "https://github.com/anetrebskii/geckit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anetrebskii/geckit.git"
  },
  "license": "MIT",
  "author": {
    "name": "Alex Netrebskii",
    "email": "aleks.netrebskii@gmail.com",
    "url": "https://github.com/anetrebskii"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --publish never",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "openai": "^6.10.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "productName": "GeckIt",
    "appId": "org.anetrebskii.GeckIt",
    "asar": true,
    "files": [
      "out",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icon",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert",
        "NSMicrophoneUsageDescription": "GeckIt listens while you dictate, to write down what you said.",
        "NSAppleEventsUsageDescription": "GeckIt pastes what you dictated into the app you were typing in, and opens a conversation in iTerm2 or Terminal."
      },
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "notarize": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "anetrebskii",
      "repo": "geckit"
    }
  }
}
