{
  "manifest_version": 3,
  "name": "GeckIt Browser",
  "version": "1.1.0",
  "description": "Lets GeckIt conversations read and use the tabs of this Chrome profile.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "tabGroups", "scripting", "debugger", "nativeMessaging", "alarms"],
  "action": { "default_title": "GeckIt Browser" },
  "host_permissions": ["<all_urls>"]
}
