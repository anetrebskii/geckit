{
  "manifest_version": 3,
  "name": "GeckIt Browser",
  "version": "1.3.1",
  "description": "Lets GeckIt conversations read, check and use your Chrome tabs. Click the icon to see which tabs they used and what they did.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "nativeMessaging",
    "alarms",
    "storage",
    "identity",
    "identity.email"
  ],
  "action": {
    "default_title": "GeckIt Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
