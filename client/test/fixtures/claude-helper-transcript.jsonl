setTimeout(() => write({ type: 'control_request', request_id: 'bg-1', request: { subtype: 'background_tasks', tool_use_id: message.tool_use_id } }), 1000)\n26\t  }\n27\t  if (message.type === 'system' && message.subtype === 'task_started') taskId = message.task_id\n28\t  if (scenario === 'moved' && message.type === 'result' && results === 0 && taskId) {\n29\t    setTimeout(() => write({ type: 'control_request', request_id: 'stop-1', request: { subtype: 'stop_task', task_id: taskId } }), 3000)\n30\t  }\n31\t  if (message.type === 'result') results += 1\n32\t})\n33\tchild.stderr.on('data', (chunk) => appendFileSync(out, JSON.stringify({ stderr: chunk.toString(), t: Date.now() - start }) + '\\n'))\n34\tconst prompts = {\n35\t  started: 'Use the Bash tool with run_in_background set to true to run exactly: sleep 6; echo background-done. Then reply with the single word started. When it finishes, reply with what it printed.',\n36\t  moved: 'Use the Bash tool (not in the background) to run exactly: ping -c 40 127.0.0.1. Then reply with what it printed, in one line.',\n37\t  agent: 'Use the Agent tool with run_in_background set to true and subagent_type general-purpose, asking it to run ls in the current folder and then read record.mjs and say how many lines it has. Then reply with the single word launched. When it finishes, reply with its answer in one line.',\n38\t  monitor: 'Use the Monitor tool to watch the output of this exact command: for i in 1 2 3 4; do echo tick $i; sleep 3; done. Then reply with the single word watching. When it ends, reply done.',\n39\t}\n40\twrite({ type: 'user', message: { role: 'user', content: prompts[scenario] } })\n41\tsetTimeout(() => { child.stdin.end(); child.kill() }, 60000)\n42\tchild.on('close', (code) => { appendFileSync(out, JSON.stringify({ closed: code, t: Date.now() - start }) + '\\n') })\n43\t"}]}, "uuid": "b77aad0e-2f35-4b07-a035-1e1b91d46cd9", "timestamp": "2026-09-22T08:17:35.829Z", "sourceToolAssistantUUID": "d1e91817-b9d6-40