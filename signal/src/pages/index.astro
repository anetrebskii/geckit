---
import Base from "@sites/core/layouts/Base.astro";
import { site } from "@site";
---
<Base site={site}>
  <main style="max-width: 32rem; margin: 20vh auto; padding: 0 1.5rem; font: 16px/1.5 system-ui, sans-serif">
    <h1 style="font-size: 1.25rem">GeckIt pairing</h1>
    <p>Introduces the GeckIt app on a phone to GeckIt on a Mac. What passes through here is encrypted with a key only the two of them have.</p>
  </main>
</Base>
